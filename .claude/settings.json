{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/sync-plugins.mjs\"",
            "timeout": 300
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "sst-common@sst-ai-skills": true,
    "sst-be-common@sst-ai-skills": true,
    "cm-be-bff-common@sst-ai-skills": true
  },
  "extraKnownMarketplaces": {
    "sst-ai-skills": {
      "source": {
        "source": "git",
        "url": "git@github.com:sst-ai-lab/sst-ai-skills.git"
      },
      "autoUpdate": false
    }
  }
}
