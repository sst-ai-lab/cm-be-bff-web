{
  "extraKnownMarketplaces": {
    "sst-ai-skills": {
      "source": {
        "source": "github",
        "repo": "sst-ai-lab/sst-ai-skills"
      },
      "autoUpdate": true
    }
  },
  "enabledPlugins": {
    "backend@sst-ai-skills": true
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "claude plugin marketplace update sst-ai-skills && claude plugin update backend@sst-ai-skills --scope project"
          }
        ]
      }
    ]
  }
}
