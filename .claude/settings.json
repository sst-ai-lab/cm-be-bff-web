{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/sync-plugins.mjs\"",
            "timeout": 300
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "backend@sst-ai-skills": true
  },
  "extraKnownMarketplaces": {
    "sst-ai-skills": {
      "source": {
        "source": "github",
        "repo": "sst-ai-lab/sst-ai-skills"
      },
      "autoUpdate": true
    }
  }
}
